# Copy to .env.local and fill in. Never commit .env.local.

# Gemini API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: models to try, in order (first that answers wins)
GEMINI_MODELS=gemini-4-argon,gemini-3.5-flash,gemini-3.1-flash-lite,gemini-flash-lite-latest

# Optional: Supabase (persistent storage). Without these, reports are saved to data/reports.json locally.
SUPABASE_URL=
SUPABASE_ANON_KEY=
